# TutorFlow — variables de entorno (copiar a .env; .env está en .gitignore)
# NO pongas valores reales en este archivo: el repositorio es público.

# --- LLM (obligatorio para preguntas que requieren redacción; /api/salud y los 403 funcionan sin él) ---
LLM_API_KEY=
# anthropic | openai-compatible | fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Solo para openai-compatible (OpenAI, Ollama, LM Studio...), p. ej. http://host.docker.internal:11434/v1
LLM_BASE_URL=

# Precios USD por millón de tokens, para calcular costoUsd. Verificar en la página oficial del proveedor y anotar la fecha.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- Embeddings (solo si RETRIEVAL_STRATEGY = vector | hybrid) ---
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_PRICE_PER_MTOK=

# --- Recuperación: full-context | bm25 | vector | hybrid (el valor por defecto lo deciden las evals) ---
RETRIEVAL_STRATEGY=

# --- Integración (los valores por defecto sirven para docker compose) ---
MOCK_API_BASE_URL=http://mock-api:4000
KNOWLEDGE_PATH=/app/knowledge
AUDIT_LOG_PATH=/app/audit/audit.jsonl

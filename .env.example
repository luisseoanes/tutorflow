# TutorFlow — variables de entorno (copiar a .env; .env está en .gitignore)
# NO pongas valores reales en este archivo: el repositorio es público. Referencia: SPEC.md §11.

# --- LLM (los 400 y los 403 de identidad/referencia funcionan sin llave; las preguntas que llegan al LLM → 503) ---
LLM_API_KEY=
# anthropic | openai-compatible   (no se deduce del formato de la llave)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Solo para openai-compatible (OpenAI, Ollama, LM Studio...), p. ej. http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Precios USD por millón de tokens, para costoUsd. Verificar en la página oficial del proveedor y anotar la fecha.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_MAX_TOKENS_PER_REQUEST=8000

# --- Recuperación: full-context | bm25 (vector | hybrid solo con embeddings configurados; experimento) ---
RETRIEVAL_STRATEGY=

# --- Embeddings (opcionales; solo para vector/hybrid) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_PRICE_PER_MTOK=

# --- Integración (los valores por defecto sirven para docker compose) ---
MOCK_API_BASE_URL=http://mock-api:4000
ROSTER_TTL_SECONDS=300
KNOWLEDGE_PATH=/app/knowledge
QUARANTINE_CHUNKS=bienestar_y_becas.md#Anexo
# Archivo de auditoría opcional (la auditoría principal va siempre a stdout)
AUDIT_LOG_PATH=

{
  "name": "tutorflow-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interfaz web de TutorFlow (SPEC-WEB.md). Consume solo GET /api/salud y POST /api/asistente/preguntar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "evidencias": "playwright test --config playwright.evidencias.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
